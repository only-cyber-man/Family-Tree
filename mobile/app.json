{
  "expo": {
    "name": "Family Tree",
    "slug": "family-tree",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "familytree",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F0E6",
    "primaryColor": "#2F5D46",
    "ios": {
      "bundleIdentifier": "pl.cyberman.familytree",
      "supportsTablet": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Family Tree uses the camera to take a photo of a person you add to your tree.",
        "NSPhotoLibraryUsageDescription": "Family Tree lets you pick a photo of a person from your library."
      }
    },
    "android": {
      "package": "pl.cyberman.familytree",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#2F5D46"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2F5D46",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#2F5D46"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F5D46",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Family Tree lets you pick a photo of a person from your library.",
          "cameraPermission": "Family Tree uses the camera to take a photo of a person you add to your tree.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
