{
	"name": "family-tree",
	"description": "Visualize your family tree",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build && yarn build:worker",
		"build:worker": "node build-worker.js",
		"start:worker": "node worker/worker.js",
		"dev:worker": "nodemon worker/worker.js",
		"start": "next start",
		"lint": "next lint",
		"add-static": "mkdir -p ./.next/standalone/public/_next && cp -r ./.next/static ./.next/standalone/public/_next/ && cp -r ./public/. ./.next/standalone/public/"
	},
	"dependencies": {
		"dotenv": "^16.4.5",
		"eventsource": "^2.0.2",
		"ics": "^3.7.6",
		"next": "14.2.5",
		"pocketbase": "^0.25.1",
		"react": "^18",
		"react-dom": "^18"
	},
	"devDependencies": {
		"@babel/core": "^7.23.7",
		"@types/eventsource": "^1.1.15",
		"@types/node": "^20",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"eslint": "^8",
		"eslint-config-next": "14.2.5",
		"nodemon": "^3.1.0",
		"typescript": "^5"
	}
}
